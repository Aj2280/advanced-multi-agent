### Provider routing (OpenAI-compatible)
# Provide at least one.
OPENAI_API_KEY=your_openai_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Example OpenRouter
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Example Groq
GROQ_API_KEY=your_groq_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Cerebras (OpenAI-compatible)
CEREBRAS_API_KEY=your_cerebras_key_here
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Google AI Studio (Gemini)
GEMINI_API_KEY=your_gemini_key_here

### Observability
OTEL_SERVICE_NAME=advanced-multi-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
AMA_METRICS_PORT=9102

### Memory backends
REDIS_URL=redis://localhost:6379/0
SQLITE_PATH=.local/episodic.db
CHROMA_PERSIST_DIR=.local/chroma

### Ollama embeddings (optional, for Chroma)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

### Workbench HTTP API (ama-api)
AMA_DISABLE_HITL=1
AMA_API_PORT=8800
AMA_API_HOST=0.0.0.0
AMA_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 for cloud/tunnel dev (allows browser on any origin when using VITE_API_BASE_URL)
AMA_API_CORS_ALLOW_ALL=0
AMA_WORKBENCH_ROOT=.local/workbenches
AMA_WORKBENCH_CMD_TIMEOUT_S=600
# Optional JSON list of argv arrays to extend npm/node allowlist
# AMA_WORKBENCH_CMD_ALLOWLIST_JSON=[["npm","install"]]
